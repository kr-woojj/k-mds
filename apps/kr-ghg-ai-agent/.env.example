# kr-ghg-ai-agent 환경 설정 예시 — placeholder 만 포함. 실제 값을 커밋하지 않는다.

# --- LLM (기본 mock; 실호출은 ALLOW_LIVE_LLM=true + credential 필요) ---
LLM_PROVIDER=mock                # azure_openai | openai | mock
LLM_MODEL=                       # openai 모델명 (예: gpt-4o-mini)
LLM_DEPLOYMENT=                  # Azure deployment 이름
LLM_API_KEY=                     # 미사용 — provider SDK 는 아래 표준 env 를 읽는다
LLM_ENDPOINT=
LLM_API_VERSION=2024-10-21
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
ALLOW_LIVE_LLM=false

# kr-ai-agents 규약과 호환되는 표준 provider env (값은 별도 보관)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Skill / Reference ---
IMO_MAPPING_SKILL_PATH=../imo-compendium-mapping-validator
REGISTRY_DB_PATH=var/registry.sqlite3
K_MDS_REFERENCE_PATH=var/reference/code_lists.json
SKILL_TIMEOUT_SECONDS=60

# --- MCP (optional) ---
MCP_TRANSPORT=off                # off | stdio
MCP_SERVER_COMMAND=              # 예: python
MCP_SERVER_ARGS=                 # 예: tools/mcp_server.py

# --- KR GEARs ---
KR_GEARS_DELIVERY_MODE=mock      # mock | http (실계약 미확인 시 http 는 차단됨)
KR_GEARS_API_URL=
KR_GEARS_API_KEY=

# --- Evidence / 정책 ---
AUDIT_LOG_DIR=evidence
MAPPING_CONFIDENCE_THRESHOLD=0.90
