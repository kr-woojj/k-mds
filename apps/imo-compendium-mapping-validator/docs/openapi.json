{
  "components": {
    "schemas": {
      "CreateMappingJobRequest": {
        "additionalProperties": false,
        "examples": [
          {
            "auto_accept_threshold": 0.9,
            "dataset": {
              "fuel_oil_consumption": 123.4,
              "ship_name": "TEST SHIP"
            },
            "input_format": "json",
            "service_context": "noon report ingestion",
            "source_dataset_id": "NOON-REPORT-FEED-01"
          }
        ],
        "properties": {
          "auto_accept_threshold": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.5,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto Accept Threshold"
          },
          "compendium_version": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compendium Version"
          },
          "dataset": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Dataset"
          },
          "input_format": {
            "pattern": "^(json|json-schema|csv-columns|api-sample)$",
            "title": "Input Format",
            "type": "string"
          },
          "service_context": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Context"
          },
          "source_dataset_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Source Dataset Id",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "source_dataset_id",
          "dataset",
          "input_format"
        ],
        "title": "CreateMappingJobRequest",
        "type": "object"
      },
      "ErrorEntry": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "title": "Error Code",
            "type": "string"
          },
          "error_detail": {
            "title": "Error Detail",
            "type": "string"
          },
          "field_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Id"
          },
          "imo_data_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imo Data Number"
          }
        },
        "required": [
          "error_code",
          "error_detail"
        ],
        "title": "ErrorEntry",
        "type": "object"
      },
      "FieldSpec": {
        "additionalProperties": false,
        "description": "단일 필드 기술 — 이름·설명은 신뢰되지 않는 데이터로 취급된다.",
        "properties": {
          "declared_format": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Declared Format"
          },
          "declared_type": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Declared Type"
          },
          "declared_unit": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Declared Unit"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "sample_values": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxItems": 20,
            "title": "Sample Values",
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "title": "FieldSpec",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KrGearsReport": {
        "additionalProperties": false,
        "description": "KR GEARS 전달용 결과 계약.",
        "examples": [
          {
            "compendium_version": "FAL50",
            "errors": [],
            "mapping_job_id": "MAPJOB-00000001",
            "payload_hash": "00000000…(sha256)",
            "selected_mappings": [
              {
                "field_id": "f0001",
                "field_name": "ship_name",
                "final_score": 1.0,
                "imo_data_number": "IMOnnnn",
                "origin": "auto",
                "path": "/ship_name",
                "registry_record_ref": {
                  "compendiumVersion": "FAL50",
                  "recordId": "IMOnnnn",
                  "recordType": "data_element"
                }
              }
            ],
            "source_dataset_id": "NOON-REPORT-FEED-01",
            "timestamp": "2026-01-01T00:00:00+00:00",
            "validation_status": "PASS"
          }
        ],
        "properties": {
          "compendium_version": {
            "title": "Compendium Version",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorEntry"
            },
            "title": "Errors",
            "type": "array"
          },
          "mapping_job_id": {
            "title": "Mapping Job Id",
            "type": "string"
          },
          "payload_hash": {
            "title": "Payload Hash",
            "type": "string"
          },
          "selected_mappings": {
            "items": {
              "$ref": "#/components/schemas/SelectedMapping"
            },
            "title": "Selected Mappings",
            "type": "array"
          },
          "source_dataset_id": {
            "title": "Source Dataset Id",
            "type": "string"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string"
          },
          "validation_status": {
            "pattern": "^(PASS|REVIEW_REQUIRED|FAIL)$",
            "title": "Validation Status",
            "type": "string"
          }
        },
        "required": [
          "mapping_job_id",
          "source_dataset_id",
          "compendium_version",
          "validation_status",
          "selected_mappings",
          "errors",
          "error_code",
          "error_detail",
          "timestamp",
          "payload_hash"
        ],
        "title": "KrGearsReport",
        "type": "object"
      },
      "ReviewDecision": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "pattern": "^(accept|reject)$",
            "title": "Action",
            "type": "string"
          },
          "field_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Field Id",
            "type": "string"
          },
          "imo_data_number": {
            "anyOf": [
              {
                "maxLength": 16,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imo Data Number"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "field_id",
          "action"
        ],
        "title": "ReviewDecision",
        "type": "object"
      },
      "ReviewRequest": {
        "additionalProperties": false,
        "examples": [
          {
            "decisions": [
              {
                "action": "accept",
                "field_id": "f0002",
                "imo_data_number": "IMOnnnn",
                "note": "noon report dataset 후보 채택"
              }
            ]
          }
        ],
        "properties": {
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/ReviewDecision"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Decisions",
            "type": "array"
          }
        },
        "required": [
          "decisions"
        ],
        "title": "ReviewRequest",
        "type": "object"
      },
      "SelectedMapping": {
        "additionalProperties": false,
        "properties": {
          "field_id": {
            "title": "Field Id",
            "type": "string"
          },
          "field_name": {
            "title": "Field Name",
            "type": "string"
          },
          "final_score": {
            "title": "Final Score",
            "type": "number"
          },
          "imo_data_number": {
            "title": "Imo Data Number",
            "type": "string"
          },
          "origin": {
            "pattern": "^(auto|review_accepted)$",
            "title": "Origin",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "registry_record_ref": {
            "additionalProperties": true,
            "title": "Registry Record Ref",
            "type": "object"
          }
        },
        "required": [
          "field_id",
          "field_name",
          "imo_data_number",
          "final_score",
          "origin",
          "registry_record_ref"
        ],
        "title": "SelectedMapping",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationRequest": {
        "additionalProperties": false,
        "examples": [
          {
            "mappings": [
              {
                "field": {
                  "declared_type": "number",
                  "declared_unit": "t",
                  "name": "fuel_oil_consumption"
                },
                "imo_data_number": "IMOnnnn"
              }
            ]
          }
        ],
        "properties": {
          "compendium_version": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compendium Version"
          },
          "mappings": {
            "items": {
              "$ref": "#/components/schemas/ValidationRequestItem"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Mappings",
            "type": "array"
          }
        },
        "required": [
          "mappings"
        ],
        "title": "ValidationRequest",
        "type": "object"
      },
      "ValidationRequestItem": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "$ref": "#/components/schemas/FieldSpec"
          },
          "imo_data_number": {
            "maxLength": 16,
            "minLength": 1,
            "title": "Imo Data Number",
            "type": "string"
          }
        },
        "required": [
          "field",
          "imo_data_number"
        ],
        "title": "ValidationRequestItem",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "IMO Compendium Registry 기반 필드 매핑·검증 API. 모든 IMO Data Number는 Registry에 존재하는 값만 반환되며, 결과에는 compendium version과 근거 record가 포함된다. 예시의 'IMOnnnn'은 자리표시 표기다 — 실제 식별자는 /api/v1/registry/elements 로 조회한다.",
    "title": "imo-compendium-mapping-validator",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/mapping/jobs": {
      "post": {
        "operationId": "create_mapping_job_api_v1_mapping_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMappingJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Mapping Job Api V1 Mapping Jobs Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "매핑 Job 생성 (동기 처리 후 저장)"
      }
    },
    "/api/v1/mapping/jobs/{job_id}": {
      "get": {
        "operationId": "get_mapping_job_api_v1_mapping_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Mapping Job Api V1 Mapping Jobs  Job Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "매핑 Job 상태 조회"
      }
    },
    "/api/v1/mapping/jobs/{job_id}/report": {
      "get": {
        "operationId": "get_mapping_report_api_v1_mapping_jobs__job_id__report_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KrGearsReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "KR GEARS 전달용 결과 Report"
      }
    },
    "/api/v1/mapping/jobs/{job_id}/review": {
      "post": {
        "operationId": "submit_review_api_v1_mapping_jobs__job_id__review_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Submit Review Api V1 Mapping Jobs  Job Id  Review Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Review 대기 필드에 대한 Human Decision 제출"
      }
    },
    "/api/v1/registry/elements/{imo_data_number}": {
      "get": {
        "operationId": "registry_element_api_v1_registry_elements__imo_data_number__get",
        "parameters": [
          {
            "in": "path",
            "name": "imo_data_number",
            "required": true,
            "schema": {
              "title": "Imo Data Number",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Registry Element Api V1 Registry Elements  Imo Data Number  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "단일 Data Element 근거 record 조회"
      }
    },
    "/api/v1/registry/versions": {
      "get": {
        "operationId": "registry_versions_api_v1_registry_versions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Registry Versions Api V1 Registry Versions Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "적재된 Compendium version 목록"
      }
    },
    "/api/v1/validation": {
      "post": {
        "operationId": "validate_api_v1_validation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Validate Api V1 Validation Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "제안 매핑에 대한 결정론 검증"
      }
    }
  }
}
