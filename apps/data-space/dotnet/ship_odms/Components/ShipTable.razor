@using ship_odms.Models
@inherits ShipTableBase

@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="krds-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>IMO 번호<small>IMO0140</small></th>
                    <th>선박명<small>IMO0142</small></th>
                    <th>선박유형<small>IMO0160</small></th>
                    <th>MARPOL 유형<small>IMO0859</small></th>
                    <th>국적<small>IMO0138</small></th>
                    <th>MMSI<small>IMO0326</small></th>
                    <th>호출부호<small>IMO0136</small></th>
                    <th>등록항<small>IMO0147</small></th>
                    <th>조회 · 내려받기</th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    @foreach (var ship in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(ship)" style="cursor: @GetRowCursor()">
                            <td>@ship.ImoNumber</td>
                            <td>@ship.ShipName</td>
                            <td>@ship.ShipType</td>
                            <td>@ship.ShipTypeMarpol</td>
                            <td>@ship.FlagState</td>
                            <td>@ship.Mmsi</td>
                            <td>@ship.CallSign</td>
                            <td>@ship.RegistryPort</td>
                            <td @onclick:stopPropagation="true">
                                <div class="krds-actions">
                                    <a href="/ships/@ship.Id/yearly-reports" class="krds-btn krds-btn-tertiary krds-btn-xs">연차보고</a>
                                    <a href="/ships/@ship.Id/voyages" class="krds-btn krds-btn-tertiary krds-btn-xs">항해이력</a>
                                    <a href="/export/ships/@ship.Id?format=json" download class="krds-btn krds-btn-xs" aria-label="JSON 내려받기">JSON</a>
                                    <a href="/export/ships/@ship.Id?format=csv" download class="krds-btn krds-btn-xs" aria-label="CSV 내려받기">CSV</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";

}
