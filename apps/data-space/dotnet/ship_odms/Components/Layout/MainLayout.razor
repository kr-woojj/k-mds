@inherits LayoutComponentBase

<a class="krds-skip" href="#main-content">본문으로 건너뛰기</a>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main id="main-content">
        <div class="top-row px-4">
            <span>IMO Compendium 기준 GHG 의무보고 데이터 표준모델 (GHG Verifier)</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    처리 중 오류가 발생했습니다.
    <a href="." class="reload">새로 고침</a>
    <button type="button" class="dismiss" aria-label="닫기">닫기</button>
</div>
