@using ship_odms.Models
@inherits PerformanceReportTableBase
@inject NavigationManager Navigation

@if (Loading)
{
    <div class="table-skeleton">Loading...</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div style="overflow-x: auto;">
        <table style="border-collapse: collapse; width: 100%; min-width: 1200px; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px #eee;">
            <thead style="background: #f5f5f5;">
                <tr>
                    <th style="@th">ID</th>
                    <th style="@th">항해 ID</th>
                    <th style="@th">구간</th>
                    <th style="@th">이벤트</th>
                    <th style="@th">운항유형</th>
                    <th style="@th">경과시간</th>
                    <th style="@th">보고유형</th>
                    <th style="@th">보고일시</th>
                    <th style="@th">위도</th>
                    <th style="@th">경도</th>
                    <th style="@th">적재상태</th>
                    <th style="@th">하위데이터</th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var r in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(r)" style="border-bottom: 1px solid #eee; cursor: @(OnRowClick.HasDelegate ? "pointer" : "default")">
                            <td style="@td">@r.Id</td>
                            <td style="@td">@r.VoyageId</td>
                            <td style="@td">@r.VoyageLeg</td>
                            <td style="@td">@r.EventType</td>
                            <td style="@td">@r.OperationType</td>
                            <td style="@td">@r.ElapsedTime</td>
                            <td style="@td">@r.ReportType</td>
                            <td style="@td">@r.ReportDatetime</td>
                            <td style="@td">@r.Latitude</td>
                            <td style="@td">@r.Longitude</td>
                            <td style="@td">@(r.LadenIndicator == true ? "적재" : "공선")</td>
                            <td style="@td">
                                @if (r.WeatherDetails != null && r.WeatherDetails.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/weather-details" style="@linkBtn">기상 @r.WeatherDetails.Count 건</a>
                                }
                                @if (r.CargoOnboard != null && r.CargoOnboard.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/cargo-onboard" style="@linkBtn;margin-left:8px">적재 @r.CargoOnboard.Count 건</a>
                                }
                                @if (r.ElectricConsumption != null && r.ElectricConsumption.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/electric-consumption" style="@linkBtn;margin-left:8px">전력 @r.ElectricConsumption.Count 건</a>
                                }
                                @if (r.FuelConsumption != null && r.FuelConsumption.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/fuel-consumption" style="@linkBtn;margin-left:8px">연료 @r.FuelConsumption.Count 건</a>
                                }
                                @if (r.MeasuredCarbonDioxide != null && r.MeasuredCarbonDioxide.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/measured-carbon-dioxide" style="@linkBtn;margin-left:8px">CO₂ @r.MeasuredCarbonDioxide.Count 건</a>
                                }
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="12" style="text-align: center; color: #888; padding: 2rem;">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public int ShipId { get; set; }
    private string th = "padding:0.75rem 1rem;font-weight:600;font-size:1rem;border-bottom:2px solid #e0e0e0;background:#f5f5f5;text-align:left;";
    private string td = "padding:0.75rem 1rem;font-size:0.98rem;background:#fff;";

    // 버튼 대신 a 태그로 네비게이션 처리
    private string linkBtn => "display:inline-block;padding:0.3em 0.8em;background:#e3e8ff;color:#2a3a8c;border-radius:4px;text-decoration:none;font-weight:500;font-size:0.95em;";
}
