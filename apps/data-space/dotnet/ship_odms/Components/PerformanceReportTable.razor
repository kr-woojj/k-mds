@using ship_odms.Models
@inherits PerformanceReportTableBase
@inject NavigationManager Navigation

@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="krds-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>항해 ID</th>
                    <th>구간<small>IMO0605</small></th>
                    <th>이벤트<small>IMO0597</small></th>
                    <th>운항유형<small>IMO0598</small></th>
                    <th>경과시간<small>IMO0600</small></th>
                    <th>보고유형<small>IMO0879</small></th>
                    <th>보고일시<small>IMO0603</small></th>
                    <th>위도<small>IMO0601</small></th>
                    <th>경도<small>IMO0602</small></th>
                    <th>적재상태<small>IMO0860</small></th>
                    <th>비고<small>IMO0606</small></th>
                    <th>하위데이터</th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var r in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(r)" style="cursor: @(OnRowClick.HasDelegate ? "pointer" : "default")">
                            <td>@r.Id</td>
                            <td>@r.VoyageId</td>
                            <td>@r.VoyageLeg</td>
                            <td>@r.EventType</td>
                            <td>@r.OperationType</td>
                            <td>@r.ElapsedTime</td>
                            <td>@r.ReportType</td>
                            <td>@r.ReportDatetime</td>
                            <td>@r.Latitude</td>
                            <td>@r.Longitude</td>
                            <td>@(r.LadenIndicator == null ? "" : r.LadenIndicator == true ? "적재" : "공선")</td>
                            <td>@r.VoyageLegRemarks</td>
                            <td>
                                @if (r.WeatherDetails != null && r.WeatherDetails.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/weather-details" class="krds-btn krds-btn-tertiary krds-btn-xs">기상 @r.WeatherDetails.Count 건</a>
                                }
                                @if (r.CargoOnboard != null && r.CargoOnboard.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/cargo-onboard" class="krds-btn krds-btn-tertiary krds-btn-xs">적재 @r.CargoOnboard.Count 건</a>
                                }
                                @if (r.ElectricConsumption != null && r.ElectricConsumption.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/electric-consumption" class="krds-btn krds-btn-tertiary krds-btn-xs">전력 @r.ElectricConsumption.Count 건</a>
                                }
                                @if (r.FuelConsumption != null && r.FuelConsumption.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/fuel-consumption" class="krds-btn krds-btn-tertiary krds-btn-xs">연료 @r.FuelConsumption.Count 건</a>
                                }
                                @if (r.MeasuredCarbonDioxide != null && r.MeasuredCarbonDioxide.Count > 0)
                                {
                                    <a href="/ships/@(r.ShipId ?? ShipId)/voyages/@r.VoyageId/performance-reports/@r.Id/measured-carbon-dioxide" class="krds-btn krds-btn-tertiary krds-btn-xs">CO₂ @r.MeasuredCarbonDioxide.Count 건</a>
                                }
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="13" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public int ShipId { get; set; }

    // 버튼 대신 a 태그로 네비게이션 처리
}
