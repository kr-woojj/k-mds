@inherits ApiErrorBannerBase
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="krds-alert krds-alert-danger" role="alert">
        <strong>표준모델 API 서버에 연결할 수 없습니다.</strong>
        백엔드 컨테이너가 떠 있는지 확인한 뒤 새로 고칩니다. (@ErrorMessage)
    </div>
}

@code {
    [Parameter]
    public Exception? Error { get; set; }
}
