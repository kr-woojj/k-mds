
@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="figma-table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fuel Consumption ID</th>
                    <th>Main Engine<small>IMO0670</small></th>
                    <th>Diesel Electric Propulsion<small>IMO0671</small></th>
                    <th>Diesel Generator<small>IMO0672</small></th>
                    <th>Aux Boiler<small>IMO0673</small></th>
                    <th>Aux Engine<small>IMO0893</small></th>
                    <th>Cargo Cooling<small>IMO0894</small></th>
                    <th>Cargo Heating<small>IMO0895</small></th>
                    <th>Diesel Power Packs<small>IMO0896</small></th>
                    <th>Dirty Petroleum Pump<small>IMO0897</small></th>
                    <th>Discharge Pump<small>IMO0898</small></th>
                    <th>DP Operations<small>IMO0899</small></th>
                    <th>Electrical Power Gen<small>IMO0900</small></th>
                    <th>Incinerator<small>IMO0901</small></th>
                    <th>Inert Gas Gen/GCUs<small>IMO0902</small></th>
                    <th>Other Fuel Devices<small>IMO0903</small></th>
                    <th>Reefer Containers<small>IMO0904</small></th>
                    <th>Shuttle Tanker Ops<small>IMO0905</small></th>
                    <th>STS Operations<small>IMO0906</small></th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var f in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(f)" style="cursor: @GetRowCursor()">
                            <td>@f.Id</td>
                            <td>@f.FuelConsumptionId</td>
                            <td>@f.FocMainEngine</td>
                            <td>@f.FocDieselElectricPropulsion</td>
                            <td>@f.FocDieselGenerator</td>
                            <td>@f.FocAuxiliaryBoiler</td>
                            <td>@f.FocAuxiliaryEngine</td>
                            <td>@f.FocCargoCooling</td>
                            <td>@f.FocCargoHeating</td>
                            <td>@f.FocDieselPowerPacks</td>
                            <td>@f.FocDirtyPetroleumProductsCargoPump</td>
                            <td>@f.FocDischargePump</td>
                            <td>@f.FocDpOperations</td>
                            <td>@f.FocElectricalPowerGeneration</td>
                            <td>@f.FocIncinerator</td>
                            <td>@f.FocInertGasGeneratorsGcus</td>
                            <td>@f.FocOtherFuelConsumingDevices</td>
                            <td>@f.FocReeferContainers</td>
                            <td>@f.FocShuttleTankerOperations</td>
                            <td>@f.FocStsOperations</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="20" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    public class FocFuelTypeDto
    {
        public int Id { get; set; }
        public int FuelConsumptionId { get; set; }
        public double? FocMainEngine { get; set; }
        public double? FocDieselElectricPropulsion { get; set; }
        public double? FocDieselGenerator { get; set; }
        public double? FocAuxiliaryBoiler { get; set; }
        public double? FocAuxiliaryEngine { get; set; }
        public double? FocCargoCooling { get; set; }
        public double? FocCargoHeating { get; set; }
        public double? FocDieselPowerPacks { get; set; }
        public double? FocDirtyPetroleumProductsCargoPump { get; set; }
        public double? FocDischargePump { get; set; }
        public double? FocDpOperations { get; set; }
        public double? FocElectricalPowerGeneration { get; set; }
        public double? FocIncinerator { get; set; }
        public double? FocInertGasGeneratorsGcus { get; set; }
        public double? FocOtherFuelConsumingDevices { get; set; }
        public double? FocReeferContainers { get; set; }
        public double? FocShuttleTankerOperations { get; set; }
        public double? FocStsOperations { get; set; }
    }

    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";
    [Parameter] public List<FocFuelTypeDto>? Items { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<FocFuelTypeDto> OnRowClick { get; set; }
}
