@using ship_odms.Models

@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="figma-table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Report ID</th>
                    <th>Boiler<small>IMO0646 · kwh</small></th>
                    <th>Generator<small>IMO0647 · kwh</small></th>
                    <th>Offset<small>IMO0648 · kwh</small></th>
                    <th>Plant<small>IMO0649 · kwh</small></th>
                    <th>Energy Cargo Cooling<small>IMO0868 · kwh</small></th>
                    <th>Energy Discharge Pump<small>IMO0869 · kwh</small></th>
                    <th>Energy Reefer<small>IMO0870 · kwh</small></th>
                    <th>Onshore Power<small>IMO0871 · kwh</small></th>
                    <th>Zero Emissions<small>IMO0872 · kwh</small></th>
                    <th>Fuel Type Cargo Cooling<small>IMO0873</small></th>
                    <th>Fuel Type Discharge Pump<small>IMO0874</small></th>
                    <th>Fuel Type Reefer<small>IMO0875</small></th>
                    <th>SFOC Cargo Cooling<small>IMO0876 · g/kWh</small></th>
                    <th>SFOC Discharge Pump<small>IMO0877 · g/kWh</small></th>
                    <th>SFOC Cargo Reefers<small>IMO0878 · g/kWh</small></th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var e in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(e)" style="cursor: @GetRowCursor()">
                            <td>@e.Id</td>
                            <td>@e.ReportId</td>
                            <td>@e.PowerBoiler</td>
                            <td>@e.PowerGenerator</td>
                            <td>@e.PowerOffset</td>
                            <td>@e.PowerPlant</td>
                            <td>@e.EnergyCargoCooling</td>
                            <td>@e.EnergyDischargePump</td>
                            <td>@e.EnergyReeferContainers</td>
                            <td>@e.EnergyOnshorePowerSupply</td>
                            <td>@e.EnergyZeroEmissionsTech</td>
                            <td>@e.FuelTypeCargoCooling</td>
                            <td>@e.FuelTypeDischargePump</td>
                            <td>@e.FuelTypeReeferContainer</td>
                            <td>@e.SfocCargoCooling</td>
                            <td>@e.SfocDischargePump</td>
                            <td>@e.SfocCargoReefers</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="17" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";
    [Parameter] public List<ElectricConsumptionDto>? Items { get; set; } = null;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; } = null;
    [Parameter] public EventCallback<ElectricConsumptionDto> OnRowClick { get; set; }
    public class ElectricConsumptionDto
    {
        public int Id { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("report_id")]
        public int ReportId { get; set; }
        public double? PowerBoiler { get; set; }
        public double? PowerGenerator { get; set; }
        public double? PowerOffset { get; set; }
        public double? PowerPlant { get; set; }
        public double? EnergyCargoCooling { get; set; }
        public double? EnergyDischargePump { get; set; }
        public double? EnergyReeferContainers { get; set; }
        public double? EnergyOnshorePowerSupply { get; set; }
        public double? EnergyZeroEmissionsTech { get; set; }
        public string? FuelTypeCargoCooling { get; set; }
        public string? FuelTypeDischargePump { get; set; }
        public string? FuelTypeReeferContainer { get; set; }
        public double? SfocCargoCooling { get; set; }
        public double? SfocDischargePump { get; set; }
        public double? SfocCargoReefers { get; set; }
        // 필요시 추가 필드 정의
    }
}
