@using System.Collections.Generic
@using ship_odms.Models

@* VoyageListTable.jsx → Blazor *@
@code {
    [Parameter]
    public List<Voyage>? Items { get; set; }
    [Parameter]
    public bool Loading { get; set; }
    [Parameter]
    public string? Error { get; set; }
    [Parameter]
    public EventCallback<Voyage> OnRowClick { get; set; }

    // 기존 VoyageDto는 삭제, 실제 모델 사용

    // public class VoyageDto ... 삭제
}

<div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>선박 ID</th>
                <th>연차보고 ID</th>
                <th>항해번호<small>IMO0191</small></th>
                <th>서비스ID<small>IMO0536</small></th>
                <th>GHG(항차)<small>IMO0855 · gCO2eq/MJ</small></th>
                <th>입항 관할<small>IMO0856</small></th>
                <th>출항 관할<small>IMO0857</small></th>
            </tr>
        </thead>
        <tbody>
            @if (Items != null && Items.Count > 0)
            {
                foreach (var v in Items)
                {
                    <tr>
                        <td>@v.Id</td>
                        <td>@v.ShipId</td>
                        <td>@v.YearReportId</td>
                        <td>@v.VoyageNumber</td>
                        <td>@v.TradeServiceId</td>
                        <td>@v.GfiPerVoyage</td>
                        <td>@v.InboundPortJurisdiction</td>
                        <td>@v.OutboundPortJurisdiction</td>
                        <td>
                            <a href="/ships/@v.ShipId/voyages/@v.Id/port-calls" class="krds-btn krds-btn-tertiary krds-btn-xs">입출항</a>
                            <a href="/ships/@v.ShipId/voyages/@v.Id/performance-reports" class="krds-btn krds-btn-tertiary krds-btn-xs">운항보고</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="krds-empty">데이터 없음</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@inject NavigationManager Navigation
@code {
        private void NavigateToPortCalls(Voyage v)
        {
            Console.WriteLine($"[DEBUG] PortCalls ShipId={v.ShipId}, VoyageId={v.Id}");
            Navigation.NavigateTo($"/ships/{v.ShipId}/voyages/{v.Id}/port-calls", true);
        }

        private void NavigateToPerformanceReports(Voyage v)
        {
            Console.WriteLine($"[DEBUG] PerfReports ShipId={v.ShipId}, VoyageId={v.Id}");
            Navigation.NavigateTo($"/ships/{v.ShipId}/voyages/{v.Id}/performance-reports", true);
        }
}
