@using ship_odms.Models
@inherits YearPerformanceReportTableBase

@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="krds-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>선박 ID</th>
                    <th>보고 연도<small>K-MDS 확장</small></th>
                    <th>연간 GHG 집계<small>IMO0854 · gCO2eq/MJ</small></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var r in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(r)" style="cursor: @GetRowCursor()">
                            <td>@r.Id</td>
                            <td>@r.ShipId</td>
                            <td>@r.ReportYear</td>
                            <td>@r.TotalGfiAnnually</td>
                            <td>
                                <a href="/ships/@r.ShipId/voyages" class="krds-btn krds-btn-tertiary krds-btn-xs">항해이력</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="4" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";
}
