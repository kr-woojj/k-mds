@using ship_odms.Models
@inherits FuelConsumptionTableBase

@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="figma-table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Report ID</th>
                    <th>Fuel Type<small>IMO0654</small></th>
                    <th>Trade Name<small>IMO0680</small></th>
                    <th>BDN Number<small>IMO0655</small></th>
                    <th>BDN Datetime<small>IMO0656</small></th>
                    <th>Bunker Received<small>IMO0657</small></th>
                    <th>Mass<small>IMO0658</small></th>
                    <th>Density<small>IMO0659</small></th>
                    <th>Sulphur<small>IMO0660</small></th>
                    <th>Viscosity<small>IMO0661</small></th>
                    <th>Water<small>IMO0662</small></th>
                    <th>HHV<small>IMO0663</small></th>
                    <th>LFV<small>IMO0664</small></th>
                    <th>Grade<small>IMO0665</small></th>
                    <th>Bunker Port<small>IMO0666</small></th>
                    <th>Bunker Port Name<small>IMO0667</small></th>
                    <th>CO2 Emission<small>IMO0668 · gCO2/g</small></th>
                    <th>Total Consumed<small>IMO0669</small></th>
                    <th>ROB<small>IMO0674</small></th>
                    <th>Sludge ROB<small>IMO0675</small></th>
                    <th>LCV Report<small>IMO0880</small></th>
                    <th>LCV<small>IMO0881</small></th>
                    <th>POS Ref<small>IMO0882</small></th>
                    <th>CH4 CF<small>IMO0891 · gCH4/gFuel</small></th>
                    <th>N2O CF<small>IMO0892 · gN2O/gFuel</small></th>
                    <th>Fresh Water Bunkered<small>IMO0639</small></th>
                    <th>Fresh Water Produced<small>IMO0640</small></th>
                    <th>Fresh Water Consumed<small>IMO0641</small></th>
                    <th>Technical Water Produced<small>IMO0642</small></th>
                    <th>Technical Water Consumed<small>IMO0643</small></th>
                    <th>Wash Water Consumed<small>IMO0644</small></th>
                    <th>Fresh Water ROB<small>IMO0645</small></th>
                    <th>CLO ROB<small>IMO0676</small></th>
                    <th>CLO Feed Rate<small>IMO0677</small></th>
                    <th>CLO Consumption<small>IMO0678</small></th>
                    <th>CLO Received<small>IMO0679</small></th>
                    <th>FOC Fuel Type</th>
                    <th>FOC Consumer Type</th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var f in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(f)" style="cursor: @GetRowCursor()">
                            <td>@f.Id</td>
                            <td>@f.ReportId</td>
                            <td>@f.FuelType</td>
                            <td>@f.FuelTypeTradeName</td>
                            <td>@f.BdnNumber</td>
                            <td>@f.BdnDatetime</td>
                            <td>@f.FuelBunkerReceived</td>
                            <td>@f.FuelMass</td>
                            <td>@f.FuelDensity</td>
                            <td>@f.FuelSulphurContent</td>
                            <td>@f.FuelViscosity</td>
                            <td>@f.FuelWaterContent</td>
                            <td>@f.FuelHhv</td>
                            <td>@f.FuelLfv</td>
                            <td>@f.FuelGrade</td>
                            <td>@f.FuelBunkerPort</td>
                            <td>@f.FuelBunkerPortName</td>
                            <td>@f.Co2Emission</td>
                            <td>@f.TotalFuelQuantityConsumed</td>
                            <td>@f.FuelQuantityRob</td>
                            <td>@f.SludgeRob</td>
                            <td>@f.FuelLcvReport</td>
                            <td>@f.FuelLcv</td>
                            <td>@f.FuelPosRef</td>
                            <td>@f.Ch4Cf</td>
                            <td>@f.N2oCf</td>
                            <td>@f.FreshWaterBunkered</td>
                            <td>@f.FreshWaterProduced</td>
                            <td>@f.FreshWaterConsumed</td>
                            <td>@f.TechnicalWaterProduced</td>
                            <td>@f.TechnicalWaterConsumed</td>
                            <td>@f.WashWaterConsumed</td>
                            <td>@f.FreshWaterRob</td>
                            <td>@f.CloRob</td>
                            <td>@f.CloFeedRate</td>
                            <td>@f.CloConsumption</td>
                            <td>@f.CloReceived</td>
                            <td>@(f.FocFuelType != null ? f.FocFuelType.Count.ToString() : "0")</td>
                            <td>@(f.FocConsumerType != null ? f.FocConsumerType.Count.ToString() : "0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="38" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";
    [Parameter] public new List<FuelConsumption>? Items { get; set; } = null;
    [Parameter] public new bool Loading { get; set; }
    [Parameter] public new string? Error { get; set; } = null;
    [Parameter] public new EventCallback<FuelConsumption> OnRowClick { get; set; }
}
