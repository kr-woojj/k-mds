@using ship_odms.Models
@inherits VoyageTableBase

@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="krds-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>선박 ID</th>
                    <th>연차보고 ID</th>
                    <th>항차번호<small>IMO0191</small></th>
                    <th>Trade Service ID<small>IMO0536</small></th>
                    <th>GHG Intensity<small>IMO0855 · gCO2eq/MJ</small></th>
                    <th>입항 관할<small>IMO0856</small></th>
                    <th>출항 관할<small>IMO0857</small></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    @foreach (var v in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(v)" style="cursor: @GetRowCursor()">
                            <td>@v.Id</td>
                            <td>@v.ShipId</td>
                            <td>@v.YearReportId</td>
                            <td>@v.VoyageNumber</td>
                            <td>@v.TradeServiceId</td>
                            <td>@v.GfiPerVoyage</td>
                            <td>@v.InboundPortJurisdiction</td>
                            <td>@v.OutboundPortJurisdiction</td>
                            <td class="krds-btn krds-btn-tertiary krds-btn-xs">
                                <button @onclick:stopPropagation="true" @onclick="() => OnRowClick.InvokeAsync(v)">상세</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";
        [Parameter] public new List<Voyage>? Items { get; set; } = null;
        [Parameter] public new bool Loading { get; set; }
        [Parameter] public new string? Error { get; set; } = null;
    [Parameter] public new EventCallback<Voyage> OnRowClick { get; set; }

}
