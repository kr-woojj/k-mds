@using ship_odms.Models
@inherits PortCallTableBase

@if (Loading)
{
    <div class="table-skeleton">Loading...</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div style="overflow-x: auto;">
        <table style="border-collapse: collapse; width: 100%; min-width: 700px; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px #eee;">
            <thead style="background: #f5f5f5;">
                <tr>
                    <th style="@th">ID</th>
                    <th style="@th">항해 ID</th>
                    <th style="@th">입항지</th>
                    <th style="@th">출항지</th>
                    <th style="@th">입항일시</th>
                    <th style="@th">출항일시</th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var p in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(p)" style="border-bottom: 1px solid #eee; cursor: @GetRowCursor()">
                            <td style="@td">@p.Id</td>
                            <td style="@td">@p.VoyageId</td>
                            <td style="@td">@p.PortArrival</td>
                            <td style="@td">@p.PortDeparture</td>
                            <td style="@td">@p.PortAta</td>
                            <td style="@td">@p.PortAtd</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" style="text-align: center; color: #888; padding: 2rem;">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string th = "padding:0.75rem 1rem;font-weight:600;font-size:1rem;border-bottom:2px solid #e0e0e0;background:#f5f5f5;text-align:left;";
    private string td = "padding:0.75rem 1rem;font-size:0.98rem;background:#fff;";
    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";
}
