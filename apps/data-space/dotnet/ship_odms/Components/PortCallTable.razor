@using ship_odms.Models
@inherits PortCallTableBase

@if (Loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="table-error">@Error</div>
}
else
{
    <div class="krds-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>항해 ID</th>
                    <th>입항지<small>IMO0108</small></th>
                    <th>출항지<small>IMO0111</small></th>
                    <th>입항일시<small>IMO0063</small></th>
                    <th>출항일시<small>IMO0065</small></th>
                </tr>
            </thead>
            <tbody>
                @if (Items != null && Items.Count > 0)
                {
                    foreach (var p in Items)
                    {
                        <tr @onclick="() => OnRowClick.InvokeAsync(p)" style="cursor: @GetRowCursor()">
                            <td>@p.Id</td>
                            <td>@p.VoyageId</td>
                            <td>@p.PortArrival</td>
                            <td>@p.PortDeparture</td>
                            <td>@p.PortAta</td>
                            <td>@p.PortAtd</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="krds-empty">데이터 없음</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string GetRowCursor() => OnRowClick.HasDelegate ? "pointer" : "default";
}
