@using System.Collections.Generic
@using ship_odms.Models
@code {
    [Parameter]
    public List<Ship>? Ships { get; set; }
}

<div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>IMO 번호<small>IMO0140</small></th>
                <th>선박명<small>IMO0142</small></th>
                <th>선박유형<small>IMO0160</small></th>
                <th>MARPOL 유형<small>IMO0859</small></th>
                <th>국적<small>IMO0138</small></th>
                <th>MMSI<small>IMO0326</small></th>
                <th>호출부호<small>IMO0136</small></th>
                <th>등록항<small>IMO0147</small></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Ships != null && Ships.Count > 0)
            {
                foreach (var ship in Ships)
                {
                    <tr>
                        <td>@ship.ImoNumber</td>
                        <td>@ship.ShipName</td>
                        <td>@ship.ShipType</td>
                        <td>@ship.ShipTypeMarpol</td>
                        <td>@ship.FlagState</td>
                        <td>@ship.Mmsi</td>
                        <td>@ship.CallSign</td>
                        <td>@ship.RegistryPort</td>
                        <td>
                            <a href="/ships/@ship.Id/yearly-reports" class="krds-btn krds-btn-tertiary krds-btn-xs">연차보고</a>
                            <a href="/ships/@ship.Id/voyages" class="krds-btn krds-btn-tertiary krds-btn-xs">항해이력</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="krds-empty">데이터 없음</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
}
