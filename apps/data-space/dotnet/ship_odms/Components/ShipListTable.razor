@using System.Collections.Generic
@using ship_odms.Models
@code {
    [Parameter]
    public List<Ship>? Ships { get; set; }
}

<div style="overflow-x: auto">
    <table style="border-collapse: collapse; width: 100%; min-width: 800px; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px #eee;">
        <thead style="background: #f5f5f5">
            <tr>
                <th style="@th">IMO 번호</th>
                <th style="@th">선박명</th>
                <th style="@th">선박유형</th>
                <th style="@th">MARPOL 유형</th>
                <th style="@th">국적</th>
                <th style="@th">MMSI</th>
                <th style="@th">호출부호</th>
                <th style="@th">등록항</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Ships != null && Ships.Count > 0)
            {
                foreach (var ship in Ships)
                {
                    <tr style="border-bottom: 1px solid #eee">
                        <td style="@td">@ship.ImoNumber</td>
                        <td style="@td">@ship.ShipName</td>
                        <td style="@td">@ship.ShipType</td>
                        <td style="@td">@ship.ShipTypeMarpol</td>
                        <td style="@td">@ship.FlagState</td>
                        <td style="@td">@ship.Mmsi</td>
                        <td style="@td">@ship.CallSign</td>
                        <td style="@td">@ship.RegistryPort</td>
                        <td style="@td">
                            <a href="/ships/@ship.Id/yearly-reports" style="@linkBtn">연차보고</a>
                            <a href="/ships/@ship.Id/voyages" style="@linkBtn;margin-left:8px">항해이력</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" style="text-align:center;color:#888;padding:2rem">데이터 없음</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private string th => "padding: 0.5rem 1rem; text-align: left; font-weight: bold; background: #f5f5f5; border-bottom: 2px solid #eee;";
    private string td => "padding: 0.5rem 1rem;";
    // JS와 동일한 스타일
    private string linkBtn => "display:inline-block;padding:0.3em 0.8em;background:#e3e8ff;color:#2a3a8c;border-radius:4px;text-decoration:none;font-weight:500;font-size:0.95em;";
}
