@using ship_odms.Models
@page "/ships/{shipId:int}/voyages/{voyageId:int}/performance-reports/{reportId:int}/measured-carbon-dioxide"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>이산화탄소 배출 상세</PageTitle>

<h2 class="krds-page-title">이산화탄소 배출 상세</h2>

@if (loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (error != null)
{
    <div class="krds-alert krds-alert-danger">오류: @error.Message</div>
}
else if (co2List != null && co2List.Count > 0)
{
    <div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Report ID</th>
                <th>Total CO2eq<small>IMO0883 · tCO2eq</small></th>
                <th>% CO2 at Sea<small>IMO0884</small></th>
                <th>Total CO2<small>IMO0885 · tCO2</small></th>
                <th>Total CO2eq Captured<small>IMO0886 · tCO2eq</small></th>
                <th>Total CH4<small>IMO0887 · tCH4</small></th>
                <th>Total CH4 to CO2<small>IMO0888 · tCH4</small></th>
                <th>Total N2O<small>IMO0889 · tN20</small></th>
                <th>Total N2O to CO2<small>IMO0890 · tN20</small></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in co2List)
            {
                <tr>
                    <td>@m.Id</td>
                    <td>@m.ReportId</td>
                    <td>@m.TotalCo2eq</td>
                    <td>@m.PercentageCo2EmittedAtSea</td>
                    <td>@m.TotalCo2</td>
                    <td>@m.TotalCo2eqCaptured</td>
                    <td>@m.TotalCh4</td>
                    <td>@m.TotalCh4ToCo2</td>
                    <td>@m.TotalN2o</td>
                    <td>@m.TotalN2oToCo2</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="krds-alert">이 보고에는 해당 데이터가 없습니다.</div>
}

@code {
    [Parameter] public int shipId { get; set; }
    [Parameter] public int voyageId { get; set; }
    [Parameter] public int reportId { get; set; }

    private List<MeasuredCarbonDioxide> co2List = new();
    private Exception? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            co2List = await Http.GetFromJsonAsync<List<MeasuredCarbonDioxide>>($"voyages/{voyageId}/performance-reports/{reportId}/measured-carbon-dioxide") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex;
        }
        loading = false;
    }
}
