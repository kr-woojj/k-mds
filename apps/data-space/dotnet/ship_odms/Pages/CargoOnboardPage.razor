@page "/ships/{shipId:int}/voyages/{voyageId:int}/performance-reports/{reportId:int}/cargo-onboard"
@using ship_odms.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>적재 상세</PageTitle>

<h2 class="krds-page-title">적재 상세</h2>

@if (loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (error != null)
{
    <div class="krds-alert krds-alert-danger">오류: @error.Message</div>
}
else if (cargoList != null && cargoList.Count > 0)
{
    <div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Report ID</th>
                <th>컨테이너 수<small>IMO0650</small></th>
                <th>적재중 컨테이너<small>IMO0651</small></th>
                <th>냉장 컨테이너<small>IMO0652</small></th>
                <th>차량<small>IMO0653</small></th>
                <th>승무원<small>IMO0086</small></th>
                <th>승객<small>IMO0087</small></th>
                <th>총중량<small>IMO0024</small></th>
                <th>BL번호<small>IMO0734</small></th>
                <th>BL발행일<small>IMO0738</small></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in cargoList)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.ReportId</td>
                    <td>@c.NumberContainers</td>
                    <td>@c.NumberFullContainer</td>
                    <td>@c.NumberFullReeferContainers</td>
                    <td>@c.NumberVehiclesOnboard</td>
                    <td>@c.NumberCrew</td>
                    <td>@c.NumberPassengers</td>
                    <td>@c.GrossWeight</td>
                    <td>@c.BlRefId</td>
                    <td>@c.BlIssuedDate</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="krds-alert">이 보고에는 해당 데이터가 없습니다.</div>
}

@code {
    [Parameter] public int shipId { get; set; }
    [Parameter] public int voyageId { get; set; }
    [Parameter] public int reportId { get; set; }

    private List<CargoOnboard> cargoList = new();
    private Exception? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            cargoList = await Http.GetFromJsonAsync<List<CargoOnboard>>($"voyages/{voyageId}/performance-reports/{reportId}/cargo-onboard") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex;
        }
        loading = false;
    }

}
