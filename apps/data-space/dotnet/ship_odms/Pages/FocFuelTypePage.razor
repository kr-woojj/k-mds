@page "/ships/{shipId:int}/voyages/{voyageId:int}/performance-reports/{reportId:int}/foc-fuel-type"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>FOC Fuel Type 상세</PageTitle>

<h2 class="krds-page-title">FOC Fuel Type 상세</h2>

@if (loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (error != null)
{
    <div class="krds-alert krds-alert-danger">오류: @error.Message</div>
}
else if (fuelList != null && fuelList.Count > 0)
{
    <div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>FuelConsumptionId</th>
                <th>MainEngine<small>IMO0670</small></th>
                <th>DieselElectricPropulsion<small>IMO0671</small></th>
                <th>DieselGenerator<small>IMO0672</small></th>
                <th>AuxBoiler<small>IMO0673</small></th>
                <th>AuxEngine<small>IMO0893</small></th>
                <th>CargoCooling<small>IMO0894</small></th>
                <th>CargoHeating<small>IMO0895</small></th>
                <th>DieselPowerPacks<small>IMO0896</small></th>
                <th>DirtyPetroleumPump<small>IMO0897</small></th>
                <th>DischargePump<small>IMO0898</small></th>
                <th>DpOperations<small>IMO0899</small></th>
                <th>ElectricalPowerGen<small>IMO0900</small></th>
                <th>Incinerator<small>IMO0901</small></th>
                <th>InertGasGenGcus<small>IMO0902</small></th>
                <th>OtherFuelDevices<small>IMO0903</small></th>
                <th>ReeferContainers<small>IMO0904</small></th>
                <th>ShuttleTankerOps<small>IMO0905</small></th>
                <th>StsOperations<small>IMO0906</small></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in fuelList)
            {
                <tr>
                    <td>@f.Id</td>
                    <td>@f.FuelConsumptionId</td>
                    <td>@f.FocMainEngine</td>
                    <td>@f.FocDieselElectricPropulsion</td>
                    <td>@f.FocDieselGenerator</td>
                    <td>@f.FocAuxiliaryBoiler</td>
                    <td>@f.FocAuxiliaryEngine</td>
                    <td>@f.FocCargoCooling</td>
                    <td>@f.FocCargoHeating</td>
                    <td>@f.FocDieselPowerPacks</td>
                    <td>@f.FocDirtyPetroleumProductsCargoPump</td>
                    <td>@f.FocDischargePump</td>
                    <td>@f.FocDpOperations</td>
                    <td>@f.FocElectricalPowerGeneration</td>
                    <td>@f.FocIncinerator</td>
                    <td>@f.FocInertGasGeneratorsGcus</td>
                    <td>@f.FocOtherFuelConsumingDevices</td>
                    <td>@f.FocReeferContainers</td>
                    <td>@f.FocShuttleTankerOperations</td>
                    <td>@f.FocStsOperations</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="krds-alert">이 보고에는 해당 데이터가 없습니다.</div>
}

@code {
    [Parameter] public int shipId { get; set; }
    [Parameter] public int voyageId { get; set; }
    [Parameter] public int reportId { get; set; }

    private List<ship_odms.Components.FocFuelTypeTable.FocFuelTypeDto> fuelList = new();
    private Exception? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            fuelList = await Http.GetFromJsonAsync<List<ship_odms.Components.FocFuelTypeTable.FocFuelTypeDto>>($"voyages/{voyageId}/performance-reports/{reportId}/foc-fuel-type") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex;
        }
        loading = false;
    }
}
