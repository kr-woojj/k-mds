@page "/dashboard"
@inject IConfiguration Config

<PageTitle>대시보드 — K-MDS GHG Verifier</PageTitle>

<h2 class="krds-page-title">데이터 확인 대시보드</h2>
<p class="krds-lede">IDS Consumer 수신 데이터의 IMO Compendium code 변환·GHG Verifier 전달 결과(총 항목, 변환 성공/실패, 전달 성공/불일치, 코드북 변환/미해결)를 run 별로 확인합니다.</p>

<iframe src="@DashboardUrl" title="mapping evidence dashboard" class="krds-frame" style="height:calc(100vh - 260px);min-height:640px"></iframe>
<p class="krds-note">대시보드 URL: <a href="@DashboardUrl" target="_blank">@DashboardUrl</a></p>

@code {
    private string DashboardUrl => Config["Portal:DashboardUrl"] ?? "http://localhost:8090/dashboard";
}
