@page "/dashboard"
@inject IConfiguration Config

<PageTitle>대시보드 — K-MDS GHG Verifier</PageTitle>

<h2 style="font-size:1.5rem;margin-bottom:0.5rem;">데이터 확인 대시보드</h2>
<p style="color:#57606a;margin-bottom:1rem;">IDS Consumer 수신 데이터의 IMO Compendium code 변환·Ship-ODMS 전달 결과(총 항목, 변환 성공/실패, 전달 성공/불일치, 코드북 변환/미해결)를 run 별로 확인합니다.</p>

<iframe src="@DashboardUrl" title="mapping evidence dashboard" style="width:100%;height:calc(100vh - 220px);min-height:640px;border:1px solid #d0d7de;border-radius:8px;background:#fff"></iframe>
<p style="font-size:12px;color:#57606a;margin-top:0.5rem;">대시보드 URL: <a href="@DashboardUrl" target="_blank">@DashboardUrl</a></p>

@code {
    private string DashboardUrl => Config["Portal:DashboardUrl"] ?? "http://localhost:8090/dashboard";
}
