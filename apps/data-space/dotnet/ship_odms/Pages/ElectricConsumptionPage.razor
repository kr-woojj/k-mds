@page "/ships/{shipId:int}/voyages/{voyageId:int}/performance-reports/{reportId:int}/electric-consumption"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>전력 소비 상세</PageTitle>

<h2 class="krds-page-title">전력 소비 상세</h2>

@if (loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (error != null)
{
    <div class="krds-alert krds-alert-danger">오류: @error.Message</div>
}
else if (electricList != null && electricList.Count > 0)
{
    <div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Report ID</th>
                <th>Boiler<small>IMO0646 · kwh</small></th>
                <th>Generator<small>IMO0647 · kwh</small></th>
                <th>Offset<small>IMO0648 · kwh</small></th>
                <th>Plant<small>IMO0649 · kwh</small></th>
                <th>Energy Cargo Cooling<small>IMO0868 · kwh</small></th>
                <th>Energy Discharge Pump<small>IMO0869 · kwh</small></th>
                <th>Energy Reefer<small>IMO0870 · kwh</small></th>
                <th>Onshore Power<small>IMO0871 · kwh</small></th>
                <th>Zero Emissions<small>IMO0872 · kwh</small></th>
                <th>Fuel Type Cargo Cooling<small>IMO0873</small></th>
                <th>Fuel Type Discharge Pump<small>IMO0874</small></th>
                <th>Fuel Type Reefer<small>IMO0875</small></th>
                <th>SFOC Cargo Cooling<small>IMO0876 · g/kWh</small></th>
                <th>SFOC Discharge Pump<small>IMO0877 · g/kWh</small></th>
                <th>SFOC Cargo Reefers<small>IMO0878 · g/kWh</small></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in electricList)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.ReportId</td>
                    <td>@e.PowerBoiler</td>
                    <td>@e.PowerGenerator</td>
                    <td>@e.PowerOffset</td>
                    <td>@e.PowerPlant</td>
                    <td>@e.EnergyCargoCooling</td>
                    <td>@e.EnergyDischargePump</td>
                    <td>@e.EnergyReeferContainers</td>
                    <td>@e.EnergyOnshorePowerSupply</td>
                    <td>@e.EnergyZeroEmissionsTech</td>
                    <td>@e.FuelTypeCargoCooling</td>
                    <td>@e.FuelTypeDischargePump</td>
                    <td>@e.FuelTypeReeferContainer</td>
                    <td>@e.SfocCargoCooling</td>
                    <td>@e.SfocDischargePump</td>
                    <td>@e.SfocCargoReefers</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="krds-alert">이 보고에는 해당 데이터가 없습니다.</div>
}

@code {
    [Parameter] public int shipId { get; set; }
    [Parameter] public int voyageId { get; set; }
    [Parameter] public int reportId { get; set; }

    private List<Components.ElectricConsumptionTable.ElectricConsumptionDto> electricList = new();
    private Exception? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            electricList = await Http.GetFromJsonAsync<List<Components.ElectricConsumptionTable.ElectricConsumptionDto>>($"voyages/{voyageId}/performance-reports/{reportId}/electric-consumption") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex;
        }
        loading = false;
    }
}
