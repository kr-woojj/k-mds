@page "/ships/{shipId:int}/voyages/{voyageId:int}/performance-reports/{reportId:int}/weather-details"
@using ship_odms.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>기상 상세</PageTitle>

<h2 class="krds-page-title">기상 상세</h2>

@if (loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (error != null)
{
    <div class="krds-alert krds-alert-danger">오류: @error.Message</div>
}
else if (weatherList != null && weatherList.Count > 0)
{
    <div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Report ID</th>
                <th>Sea State<small>IMO0363</small></th>
                <th>Wind Force<small>IMO0625</small></th>
                <th>Wind Speed<small>IMO0359</small></th>
                <th>Wind Dir<small>IMO0360</small></th>
                <th>Wind Dir Relative<small>IMO0626</small></th>
                <th>Wind Dir True<small>IMO0627</small></th>
                <th>Air Temp<small>IMO0628</small></th>
                <th>Atmospheric Pressure<small>IMO0629</small></th>
                <th>Sea Dir Relative<small>IMO0630</small></th>
                <th>Sea Dir True<small>IMO0631</small></th>
                <th>Sea Height<small>IMO0632</small></th>
                <th>Swell Dir Relative<small>IMO0633</small></th>
                <th>Swell Dir True<small>IMO0634</small></th>
                <th>Swell Height<small>IMO0635</small></th>
                <th>Ocean Dir Relative<small>IMO0636</small></th>
                <th>Ocean Dir True<small>IMO0637</small></th>
                <th>Ocean Dir Weather Provider<small>IMO0638</small></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in weatherList)
            {
                <tr>
                    <td>@w.Id</td>
                    <td>@w.ReportId</td>
                    <td>@w.SeaState</td>
                    <td>@w.WindForce</td>
                    <td>@w.WindSpeed</td>
                    <td>@w.WindDir</td>
                    <td>@w.WindDirRelative</td>
                    <td>@w.WindDirTrue</td>
                    <td>@w.AirTemperature</td>
                    <td>@w.AtmosphericPressure</td>
                    <td>@w.SeaDirRelative</td>
                    <td>@w.SeaDirTrue</td>
                    <td>@w.SeaHeight</td>
                    <td>@w.SwellDirRelative</td>
                    <td>@w.SwellDirTrue</td>
                    <td>@w.SwellHeight</td>
                    <td>@w.OceanDirRelative</td>
                    <td>@w.OceanDirTrue</td>
                    <td>@w.OceanDirWeatherProvider</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="krds-alert">이 보고에는 해당 데이터가 없습니다.</div>
}

@code {
    [Parameter] public int shipId { get; set; }
    [Parameter] public int voyageId { get; set; }
    [Parameter] public int reportId { get; set; }

    private List<WeatherDetails> weatherList = new();
    private Exception? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            // Use relative path so HttpClient.BaseAddress (set from env) is respected
            weatherList = await Http.GetFromJsonAsync<List<WeatherDetails>>($"voyages/{voyageId}/performance-reports/{reportId}/weather-details") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex;
        }
        loading = false;
    }
}
