@page "/"
@using ship_odms.Models
@using ship_odms.Services
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>선박 목록</PageTitle>

<h2 class="krds-page-title">선박 목록</h2>
<p class="krds-lede">표준모델 DB 에 저장된 선박입니다. 내려받기는 선박 1척의 항차·입출항·운항 보고와 하위 표를 저장값 그대로 내보냅니다(JSON 한 파일, 또는 표별 CSV 를 묶은 zip).</p>

<ApiErrorBanner ErrorMessage="@Error" />

<ShipTable Items="Ships" Loading="@Loading" Error="@Error" OnRowClick="OnRowClick" />

@code {
    private List<Ship>? Ships = new();
    private bool Loading = true;
    private string? Error = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Loading = true;
            Error = null;
            Ships = await Api.GetAsync<List<Ship>>("ships");
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private void OnRowClick(Ship ship)
    {
        Navigation.NavigateTo($"/ships/{ship.Id}/yearly-reports");
    }
}
