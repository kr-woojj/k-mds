@page "/ships/{shipId:int}/voyages/{voyageId:int}/performance-reports/{reportId:int}/foc-consumer-type"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>FOC Consumer Type 상세</PageTitle>

<h2 class="krds-page-title">FOC Consumer Type 상세</h2>

@if (loading)
{
    <div class="table-skeleton">불러오는 중입니다.</div>
}
else if (error != null)
{
    <div class="krds-alert krds-alert-danger">오류: @error.Message</div>
}
else if (consumerList != null && consumerList.Count > 0)
{
    <div class="krds-table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>FuelConsumptionId</th>
                <th>MainEngineUsed<small>IMO0907</small></th>
                <th>MainEngineConsumed<small>IMO0908</small></th>
                <th>DieselElectricUsed<small>IMO0909</small></th>
                <th>DieselElectricConsumed<small>IMO0910</small></th>
                <th>DieselGenUsed<small>IMO0911</small></th>
                <th>DieselGenConsumed<small>IMO0912</small></th>
                <th>AuxBoilerUsed<small>IMO0913</small></th>
                <th>AuxBoilerConsumed<small>IMO0914</small></th>
                <th>AuxEngineUsed<small>IMO0915</small></th>
                <th>AuxEngineConsumed<small>IMO0916</small></th>
                <th>CargoCoolingUsed<small>IMO0917</small></th>
                <th>CargoCoolingConsumed<small>IMO0918</small></th>
                <th>CargoHeatingUsed<small>IMO0919</small></th>
                <th>CargoHeatingConsumed<small>IMO0920</small></th>
                <th>DieselPowerPacksUsed<small>IMO0921</small></th>
                <th>DieselPowerPacksConsumed<small>IMO0922</small></th>
                <th>DirtyPetroleumPumpUsed<small>IMO0923</small></th>
                <th>DirtyPetroleumPumpConsumed<small>IMO0924</small></th>
                <th>DischargePumpUsed<small>IMO0925</small></th>
                <th>DischargePumpConsumed<small>IMO0926</small></th>
                <th>DpOpsUsed<small>IMO0927</small></th>
                <th>DpOpsConsumed<small>IMO0928</small></th>
                <th>ElectricalPowerGenUsed<small>IMO0929</small></th>
                <th>ElectricalPowerGenConsumed<small>IMO0930</small></th>
                <th>IncineratorUsed<small>IMO0931</small></th>
                <th>IncineratorConsumed<small>IMO0932</small></th>
                <th>InertGasGenUsed<small>IMO0933</small></th>
                <th>InertGasGenConsumed<small>IMO0934</small></th>
                <th>OtherFuelDevicesUsed<small>IMO0935</small></th>
                <th>OtherFuelDevicesConsumed<small>IMO0936</small></th>
                <th>ReeferContainersUsed<small>IMO0937</small></th>
                <th>ReeferContainersConsumed<small>IMO0938</small></th>
                <th>ShuttleTankerOpsUsed<small>IMO0939</small></th>
                <th>ShuttleTankerOpsConsumed<small>IMO0940</small></th>
                <th>StsOpsUsed<small>IMO0941</small></th>
                <th>StsOpsConsumed<small>IMO0942</small></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in consumerList)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.FuelConsumptionId</td>
                    <td>@c.FuelUsedMainEngine</td>
                    <td>@c.FuelConsumedMainEngine</td>
                    <td>@c.FuelUsedDieselElectricPropulsion</td>
                    <td>@c.FuelConsumedDieselElectricPropulsion</td>
                    <td>@c.FuelUsedDieselGenerator</td>
                    <td>@c.FuelConsumedDieselGenerator</td>
                    <td>@c.FuelUsedAuxiliaryBoiler</td>
                    <td>@c.FuelConsumedAuxiliaryBoiler</td>
                    <td>@c.FuelUsedAuxiliaryEngine</td>
                    <td>@c.FuelConsumedAuxiliaryEngine</td>
                    <td>@c.FuelUsedCargoCooling</td>
                    <td>@c.FuelConsumedCargoCooling</td>
                    <td>@c.FuelUsedCargoHeating</td>
                    <td>@c.FuelConsumedCargoHeating</td>
                    <td>@c.FuelUsedDieselPowerPacks</td>
                    <td>@c.FuelConsumedDieselPowerPacks</td>
                    <td>@c.FuelUsedDirtyPetroleumProductsCargoPump</td>
                    <td>@c.FuelConsumedDirtyPetroleumProductsCargoPump</td>
                    <td>@c.FuelUsedDischargePump</td>
                    <td>@c.FuelConsumedDischargePump</td>
                    <td>@c.FuelUsedDpOperations</td>
                    <td>@c.FuelConsumedDpOperations</td>
                    <td>@c.FuelUsedElectricalPowerGeneration</td>
                    <td>@c.FuelConsumedElectricalPowerGeneration</td>
                    <td>@c.FuelUsedIncinerator</td>
                    <td>@c.FuelConsumedIncinerator</td>
                    <td>@c.FuelUsedInertGasGeneratorsGcus</td>
                    <td>@c.FuelConsumedInertGasGeneratorsGcus</td>
                    <td>@c.FuelUsedOtherFuelConsumingDevices</td>
                    <td>@c.FuelConsumedOtherFuelConsumingDevices</td>
                    <td>@c.FuelUsedReeferContainers</td>
                    <td>@c.FuelConsumedReeferContainers</td>
                    <td>@c.FuelUsedShuttleTankerOperations</td>
                    <td>@c.FuelConsumedShuttleTankerOperations</td>
                    <td>@c.FuelUsedStsOperations</td>
                    <td>@c.FuelConsumedStsOperations</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="krds-alert">이 보고에는 해당 데이터가 없습니다.</div>
}

@code {
    [Parameter] public int shipId { get; set; }
    [Parameter] public int voyageId { get; set; }
    [Parameter] public int reportId { get; set; }

    private List<ship_odms.Components.FocConsumerTypeTable.FocConsumerTypeDto> consumerList = new();
    private Exception? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            consumerList = await Http.GetFromJsonAsync<List<ship_odms.Components.FocConsumerTypeTable.FocConsumerTypeDto>>($"voyages/{voyageId}/performance-reports/{reportId}/foc-consumer-type") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex;
        }
        loading = false;
    }
}
