@using System.Net.Http.Json
@using ship_odms.Models
@inject HttpClient Http

<PageTitle>입출항 기록</PageTitle>

<h1 style="font-size:2rem;margin-bottom:1.5rem">입출항 기록</h1>
<ApiErrorBanner Error="error" />
@if (loading)
{
    <Loading />
}
else
{
    <PortCallTable Items="portCalls" />
}

@code {
    [Parameter]
    public int ShipId { get; set; }
    [Parameter]
    public int VoyageId { get; set; }
    private List<PortCall> portCalls = new();
    private Exception? error;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            portCalls = await Http.GetFromJsonAsync<List<PortCall>>($"api/ships/{ShipId}/voyages/{VoyageId}/port-calls") ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex;
            portCalls = new();
        }
        loading = false;
    }
}
