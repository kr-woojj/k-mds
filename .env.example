# k-mds 환경변수 템플릿 — 이 파일을 복사해 `k-mds/.env` 를 만들고 값을 채운다.
#
#   cp .env.example .env
#
# 규칙
# - 실제 값은 `.env` 에만 둔다. `.env` 는 .gitignore 에 등록되어 있어 커밋되지 않는다.
# - 이 템플릿에는 값을 적지 않는다. `<sample: …>` 는 어떤 값이 들어가야 하는지에 대한 설명이다.
# - 외부 기관(RIMS 등)이 이 저장소를 포크·클론해 쓸 때는 이 템플릿만 보고 `.env` 를 만들 수 있어야 한다.
# - 로그·증적·커밋 메시지에 값을 적지 않는다. 커밋 전 검사: `uv run python scripts/check_secrets.py --staged`
#
# 읽는 곳
# - docker compose: `docker compose --env-file .env -f verification/automation/compose.yaml up -d --build`
# - 러너·하네스(호스트 실행): verification/run_s11.py 가 `k-mds/.env` 를 읽는다 (경로 변경: KMDS_ENV_FILE)
# - 에이전트 라이브 LLM 시험: apps/kr-ghg-ai-agent tests/integration/test_live_llm.py 도 같은 파일을 읽는다

# ---------------------------------------------------------------------------
# 1. LLM — 둘 중 하나를 고른다. 선택하지 않으면 에이전트는 mock 으로 동작한다.
# ---------------------------------------------------------------------------
# (a) Gemini (OpenAI 호환 엔드포인트 경유)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=<sample: Google AI Studio 에서 발급한 API 키. 'AIza' 로 시작하는 39자>

# (b) 오픈 모델 — vLLM / Ollama / LM Studio 등 OpenAI 호환 서버. (a) 를 주석 처리하고 아래 주석을 푼다.
#     실증 기준 구성(2026-10): 중소조선연구원(RIMS) 테스트 서버의 Qwen3.8-27B (vLLM, 호출명 qwen, 키는 RIMS 발급)
#LLM_PROVIDER=openai
#LLM_MODEL=<sample: 서버의 API 호출용 모델명. 예 qwen>
#LLM_ENDPOINT=<sample: http://<오픈 모델 호스트>:<포트>/v1  (OpenAI 호환 base_url)>
#OPENAI_API_KEY=<sample: 서버 운영 기관이 발급한 API 키. 키 검사가 없는 서버는 임의 문자열. 예 local>
#LLM_DISABLE_THINKING=true     # Qwen3 등 사고(thinking) 모델: 사고 과정을 꺼서 응답을 빠르게 한다 (에이전트·tool-call 프록시 공통)
#LLM_REASONING_EFFORT=low      # low | medium | xhigh — 매핑 후보 제안에는 low 로 충분하다
# 서버에 tool-call 파서가 없으면 n8n 챗봇은 compose 의 qwen-tool-proxy(:8091)를 거친다. 프록시는 위 LLM_ENDPOINT 를 upstream 으로 쓴다.

# (c) 상용 OpenAI / Azure OpenAI 를 직접 쓸 때만 (선택)
#OPENAI_API_KEY=<sample: OpenAI API 키. 'sk-' 로 시작>
#OPENAI_BASE_URL=<sample: 프록시·게이트웨이를 쓸 때의 기본 URL. 없으면 비움>
#AZURE_OPENAI_API_KEY=<sample: Azure OpenAI 리소스 키>
#AZURE_OPENAI_ENDPOINT=<sample: https://<리소스 이름>.openai.azure.com>
#AZURE_OPENAI_DEPLOYMENT=<sample: 배포(deployment) 이름>
#AZURE_OPENAI_API_VERSION=2024-10-21

# 라이브 LLM 호출 허용 (시험·실증 시 true). 컨테이너는 compose 가 true 로 고정한다.
ALLOW_LIVE_LLM=false

# ---------------------------------------------------------------------------
# 2. K-MDS IDS Consumer 커넥터 — T2(아티팩트 수신) 단계. 비우면 T2 는 NOT_TESTED 로 기록되고 보관본으로 진행한다.
#    값은 K-MDS 운영 기관(IDS 서버 담당)에게 받는다. 주소·계정은 참여기관 내부 정보이므로 문서·증적에 쓰지 않는다.
# ---------------------------------------------------------------------------
IDS_CONNECTOR_BASE=<sample: https://<K-MDS IDS 호스트>:<Consumer 관리 포트>  예 https://ids.example.org:8081>
IDS_CONNECTOR_USER=<sample: Consumer 커넥터 관리 API 계정>
IDS_CONNECTOR_PASSWORD=<sample: 위 계정의 비밀번호>

# ---------------------------------------------------------------------------
# 3. 서비스 주소 — 호스트에서 러너·하네스를 직접 돌릴 때만. compose 안에서는 서비스 이름으로 고정되어 있다.
# ---------------------------------------------------------------------------
SHIP_ODMS_BASE=http://localhost:8088
AGENT_BASE=http://localhost:8001

# ---------------------------------------------------------------------------
# 4. KR GEARs 전달 — 실계약 전에는 mock 만 허용된다.
# ---------------------------------------------------------------------------
KR_GEARS_DELIVERY_MODE=mock
#KR_GEARS_API_URL=<sample: https://<KR GEARs API 호스트>/api/...  (실계약 후 KR 이 지정)>
#KR_GEARS_API_KEY=<sample: KR 이 발급한 API 키>

# ---------------------------------------------------------------------------
# 5. 기타
# ---------------------------------------------------------------------------
K_MDS_LOG_LEVEL=INFO
