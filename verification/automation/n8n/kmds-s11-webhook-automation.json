{
 "name": "K-MDS 실증 자동화 (GHG 의무보고 데이터 상호운용성)",
 "nodes": [
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "kmds-s11",
    "responseMode": "responseNode",
    "options": {}
   },
   "id": "trigger",
