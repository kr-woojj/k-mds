# 자동화 스택이 읽는 환경변수는 저장소 루트의 `k-mds/.env` 하나로 관리한다. 템플릿: `k-mds/.env.example`.
#
#   cd k-mds
#   cp .env.example .env            # 값을 채운다 (커밋되지 않는다)
#   docker compose --env-file .env -f verification/automation/compose.yaml up -d --build
#
# compose 가 참조하는 이름: LLM_PROVIDER, LLM_MODEL, LLM_ENDPOINT, GEMINI_API_KEY, OPENAI_API_KEY, OPENAI_BASE_URL,
#                           IDS_CONNECTOR_BASE, IDS_CONNECTOR_USER, IDS_CONNECTOR_PASSWORD
# 이 파일에는 값을 적지 않는다.
