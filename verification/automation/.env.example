# K-MDS S-1-1 자동화 스택 환경변수 이름 목록 — 실제 값은 저장소 밖(.env.master 등)에 두고 `docker compose --env-file <파일>` 로 주입한다.
# 값을 이 파일이나 커밋에 적지 않는다.

# --- LLM (둘 중 하나) ---
# (a) Gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# (b) 오픈 모델 — OpenAI 호환 서버(vLLM/Ollama/LM Studio). 주석을 바꿔 사용.
#LLM_PROVIDER=openai
#LLM_MODEL=qwen2.5-32b-instruct        # 서버에 올린 모델 이름
#LLM_ENDPOINT=http://<open-model-host>:8000/v1
#OPENAI_API_KEY=local                   # 오픈 모델 서버는 임의 문자열이면 됨

# --- K-MDS IDS Consumer (T2 아티팩트 수신; 없으면 T2 = NOT_TESTED) ---
IDS_CONNECTOR_BASE=
IDS_CONNECTOR_USER=
IDS_CONNECTOR_PASSWORD=
