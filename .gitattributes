# 줄바꿈 정규화: 저장소에는 LF로 저장하고 checkout 시 OS 기본을 따른다.
* text=auto

# 향후 data/raw 공식 원본은 이진 파일로 취급한다 (줄바꿈 변환 금지).
*.xlsx binary
*.pdf binary

# generated JSON Schema는 모든 OS에서 LF로 checkout한다.
# Windows fresh clone의 CRLF 변환으로 인한 Schema Drift False Positive를 방지한다.
schemas/generated/*.schema.json text eol=lf

# git 훅은 셸 스크립트이므로 모든 OS 에서 LF 로 checkout 한다 (CRLF 면 Linux 에서 실행되지 않는다).
scripts/githooks/* text eol=lf
