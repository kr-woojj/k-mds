{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "minLength": 1,
          "title": "Evidenceid",
          "type": "string"
        },
        "falVersion": {
          "minLength": 1,
          "title": "Falversion",
          "type": "string"
        },
        "ontologyVersion": {
          "minLength": 1,
          "title": "Ontologyversion",
          "type": "string"
        },
        "profileVersion": {
          "minLength": 1,
          "title": "Profileversion",
          "type": "string"
        },
        "resourceUri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceuri"
        },
        "sourceFile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcefile"
        },
        "sourceHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcehash"
        }
      },
      "required": [
        "evidenceId",
        "falVersion",
        "ontologyVersion",
        "profileVersion"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "ERROR",
        "WARNING"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "GovernanceDecisionStatus": {
      "description": "Governance Decision 상태 — Execution PASS/FAIL(ResultStatus)과 의미가 다르다.",
      "enum": [
        "APPROVED",
        "REVIEW_REQUIRED",
        "REJECTED"
      ],
      "title": "GovernanceDecisionStatus",
      "type": "string"
    },
    "GovernanceDecisionType": {
      "enum": [
        "DATASET",
        "DATA_ELEMENT",
        "ELEMENT_OCCURRENCE",
        "MAPPING",
        "BUSINESS_RULE",
        "DATA_QUALITY"
      ],
      "title": "GovernanceDecisionType",
      "type": "string"
    },
    "GovernanceResult": {
      "additionalProperties": false,
      "description": "Evidence가 필수인 최종 Governance Decision Contract.",
      "properties": {
        "decisionId": {
          "minLength": 1,
          "title": "Decisionid",
          "type": "string"
        },
        "decisionType": {
          "$ref": "#/$defs/GovernanceDecisionType"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "humanReviewRequired": {
          "title": "Humanreviewrequired",
          "type": "boolean"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sourceResults": {
          "items": {
            "$ref": "#/$defs/SkillResult"
          },
          "title": "Sourceresults",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/GovernanceDecisionStatus"
        },
        "subjectId": {
          "minLength": 1,
          "title": "Subjectid",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "decisionId",
        "decisionType",
        "status",
        "subjectId",
        "summary",
        "rationale",
        "evidence",
        "humanReviewRequired"
      ],
      "title": "GovernanceResult",
      "type": "object"
    },
    "ResultStatus": {
      "enum": [
        "PASS",
        "WARNING",
        "FAIL"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "SkillResult": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Errors",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "humanReviewRequired": {
          "title": "Humanreviewrequired",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "humanReviewRequired"
      ],
      "title": "SkillResult",
      "type": "object"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "actualValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actualvalue"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "relatedRuleIds": {
          "items": {
            "type": "string"
          },
          "title": "Relatedruleids",
          "type": "array"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "ruleId"
      ],
      "title": "ValidationFinding",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/SkillResult"
    },
    {
      "$ref": "#/$defs/ValidationFinding"
    },
    {
      "$ref": "#/$defs/Evidence"
    },
    {
      "$ref": "#/$defs/GovernanceResult"
    }
  ],
  "title": "k-mds Validation Contract Models"
}
