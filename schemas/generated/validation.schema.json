{
  "$defs": {
    "DrawingReviewCategory": {
      "description": "Restricted Drawing Review가 결정한 Drawing 의미 Category.",
      "enum": [
        "imo_compendium_model_reference",
        "documentation",
        "out_of_scope_visual",
        "separate_visual_review_required",
        "undecided"
      ],
      "title": "DrawingReviewCategory",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "minLength": 1,
          "title": "Evidenceid",
          "type": "string"
        },
        "falVersion": {
          "minLength": 1,
          "title": "Falversion",
          "type": "string"
        },
        "ontologyVersion": {
          "minLength": 1,
          "title": "Ontologyversion",
          "type": "string"
        },
        "profileVersion": {
          "minLength": 1,
          "title": "Profileversion",
          "type": "string"
        },
        "resourceUri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resourceuri"
        },
        "sourceFile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcefile"
        },
        "sourceHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcehash"
        }
      },
      "required": [
        "evidenceId",
        "falVersion",
        "ontologyVersion",
        "profileVersion"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FindingAuthorization": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/FindingDisposition"
        },
        "reasonCode": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "title": "Reasoncode",
          "type": "string"
        },
        "sheetOrdinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheetordinal"
        }
      },
      "required": [
        "code",
        "disposition",
        "reasonCode"
      ],
      "title": "FindingAuthorization",
      "type": "object"
    },
    "FindingDisposition": {
      "enum": [
        "resolved",
        "accepted_for_reviewed_scope",
        "remains_blocking"
      ],
      "title": "FindingDisposition",
      "type": "string"
    },
    "FindingSeverity": {
      "enum": [
        "ERROR",
        "WARNING"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "GovernanceDecisionStatus": {
      "description": "Governance Decision 상태 — Execution PASS/FAIL(ResultStatus)과 의미가 다르다.",
      "enum": [
        "APPROVED",
        "REVIEW_REQUIRED",
        "REJECTED"
      ],
      "title": "GovernanceDecisionStatus",
      "type": "string"
    },
    "GovernanceDecisionType": {
      "enum": [
        "DATASET",
        "DATA_ELEMENT",
        "ELEMENT_OCCURRENCE",
        "MAPPING",
        "BUSINESS_RULE",
        "DATA_QUALITY"
      ],
      "title": "GovernanceDecisionType",
      "type": "string"
    },
    "GovernanceResult": {
      "additionalProperties": false,
      "description": "Evidence가 필수인 최종 Governance Decision Contract.",
      "properties": {
        "decisionId": {
          "minLength": 1,
          "title": "Decisionid",
          "type": "string"
        },
        "decisionType": {
          "$ref": "#/$defs/GovernanceDecisionType"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "humanReviewRequired": {
          "title": "Humanreviewrequired",
          "type": "boolean"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sourceResults": {
          "items": {
            "$ref": "#/$defs/SkillResult"
          },
          "title": "Sourceresults",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/GovernanceDecisionStatus"
        },
        "subjectId": {
          "minLength": 1,
          "title": "Subjectid",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "decisionId",
        "decisionType",
        "status",
        "subjectId",
        "summary",
        "rationale",
        "evidence",
        "humanReviewRequired"
      ],
      "title": "GovernanceResult",
      "type": "object"
    },
    "HeaderConfidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ],
      "title": "HeaderConfidence",
      "type": "string"
    },
    "ModelReferenceReview": {
      "additionalProperties": false,
      "description": "Drawing-only Sheet의 Drawing 의미에 대한 Restricted Review 결과 선언.\n\nUML 내용, Class·Attribute·Association 이름, Drawing Target, Image 이름은\n저장하지 않는다 — Controlled Boolean·Enum·Logical Evidence ID만 허용한다.\n`external_verification_technically_confirmed`는 외부 Audit System Connector가\n실제 Evidence 실재를 확인한 경우에만 true가 될 수 있다. Public Validator에는\nConnector가 없으므로 Assertion(`external_verification_asserted`)과 분리한다.",
      "properties": {
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "drawingReviewCategory": {
          "$ref": "#/$defs/DrawingReviewCategory"
        },
        "evidenceReferenceId": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidencereferenceid"
        },
        "externalVerificationAsserted": {
          "default": false,
          "title": "Externalverificationasserted",
          "type": "boolean"
        },
        "externalVerificationTechnicallyConfirmed": {
          "default": false,
          "title": "Externalverificationtechnicallyconfirmed",
          "type": "boolean"
        },
        "modelReferenceReviewerRecorded": {
          "default": false,
          "title": "Modelreferencereviewerrecorded",
          "type": "boolean"
        },
        "modelReferenceScopeApproved": {
          "default": false,
          "title": "Modelreferencescopeapproved",
          "type": "boolean"
        },
        "referenceModelAlignmentApproved": {
          "default": false,
          "title": "Referencemodelalignmentapproved",
          "type": "boolean"
        },
        "sheetOrdinal": {
          "minimum": 0,
          "title": "Sheetordinal",
          "type": "integer"
        }
      },
      "required": [
        "sheetOrdinal",
        "drawingReviewCategory",
        "completed"
      ],
      "title": "ModelReferenceReview",
      "type": "object"
    },
    "NormalizationAuthorization": {
      "additionalProperties": false,
      "description": "sourceId와 Inspection Report Identity에 결합된 Normalize 승인.",
      "properties": {
        "acknowledgedFindings": {
          "items": {
            "$ref": "#/$defs/FindingAuthorization"
          },
          "title": "Acknowledgedfindings",
          "type": "array"
        },
        "approvedOutputRootId": {
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$",
          "title": "Approvedoutputrootid",
          "type": "string"
        },
        "humanReviewCompleted": {
          "title": "Humanreviewcompleted",
          "type": "boolean"
        },
        "inspectionReportId": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inspectionreportid",
          "type": "string"
        },
        "modelReferenceReviews": {
          "items": {
            "$ref": "#/$defs/ModelReferenceReview"
          },
          "title": "Modelreferencereviews",
          "type": "array"
        },
        "outputStorageClass": {
          "const": "internal-restricted",
          "title": "Outputstorageclass",
          "type": "string"
        },
        "sheets": {
          "items": {
            "$ref": "#/$defs/SheetAuthorization"
          },
          "minItems": 1,
          "title": "Sheets",
          "type": "array"
        },
        "sourceId": {
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "sourceId",
        "inspectionReportId",
        "outputStorageClass",
        "approvedOutputRootId",
        "sheets",
        "humanReviewCompleted"
      ],
      "title": "NormalizationAuthorization",
      "type": "object"
    },
    "OutputRootBinding": {
      "additionalProperties": false,
      "description": "Logical Root ID를 실제 Restricted Path에 결합하는 Local Binding.\n\nActual Runtime에서는 Restricted Artifact이며 Public Repository에는\nModel과 Synthetic Fixture만 존재한다. root_path는 Validator 결과에\n복사하지 않는다.",
      "properties": {
        "rootId": {
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$",
          "title": "Rootid",
          "type": "string"
        },
        "rootPath": {
          "minLength": 1,
          "title": "Rootpath",
          "type": "string"
        },
        "storageClass": {
          "const": "internal-restricted",
          "title": "Storageclass",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "rootId",
        "storageClass",
        "rootPath"
      ],
      "title": "OutputRootBinding",
      "type": "object"
    },
    "ResultStatus": {
      "enum": [
        "PASS",
        "WARNING",
        "FAIL"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "SheetAuthorization": {
      "additionalProperties": false,
      "description": "sheetOrdinal로 식별하는 Sheet별 승인 — Sheet 이름은 저장하지 않는다.",
      "properties": {
        "classification": {
          "$ref": "#/$defs/SheetClassification"
        },
        "exclusionReasonCode": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusionreasoncode"
        },
        "headerConfidence": {
          "$ref": "#/$defs/HeaderConfidence"
        },
        "headerRow": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headerrow"
        },
        "mediumConfidenceApproved": {
          "default": false,
          "title": "Mediumconfidenceapproved",
          "type": "boolean"
        },
        "normalize": {
          "title": "Normalize",
          "type": "boolean"
        },
        "sheetOrdinal": {
          "minimum": 0,
          "title": "Sheetordinal",
          "type": "integer"
        }
      },
      "required": [
        "sheetOrdinal",
        "classification",
        "normalize",
        "headerConfidence"
      ],
      "title": "SheetAuthorization",
      "type": "object"
    },
    "SheetClassification": {
      "enum": [
        "data_table",
        "code_list",
        "metadata_or_readme",
        "excluded_non_data",
        "model_reference"
      ],
      "title": "SheetClassification",
      "type": "string"
    },
    "SkillResult": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Errors",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "humanReviewRequired": {
          "title": "Humanreviewrequired",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "humanReviewRequired"
      ],
      "title": "SkillResult",
      "type": "object"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "actualValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actualvalue"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "relatedRuleIds": {
          "items": {
            "type": "string"
          },
          "title": "Relatedruleids",
          "type": "array"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "ruleId"
      ],
      "title": "ValidationFinding",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/SkillResult"
    },
    {
      "$ref": "#/$defs/ValidationFinding"
    },
    {
      "$ref": "#/$defs/Evidence"
    },
    {
      "$ref": "#/$defs/GovernanceResult"
    },
    {
      "$ref": "#/$defs/NormalizationAuthorization"
    },
    {
      "$ref": "#/$defs/OutputRootBinding"
    }
  ],
  "title": "k-mds Validation Contract Models"
}
